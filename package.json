{
  "name": "@ratmath/chaos",
  "version": "0.3.0",
  "description": "Dynamical systems and chaos for RatMath: orbits, periodic points, bifurcations, Lyapunov exponents, fractals, maps of the plane and flows, exact or certified",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test --timeout 60000 ./tests",
    "docs:build": "bun scripts/build-docs.js && node scripts/build-llms.mjs",
    "docs:llms": "node scripts/build-llms.mjs"
  },
  "keywords": [
    "dynamical-systems",
    "chaos",
    "bifurcation",
    "fractal",
    "lyapunov",
    "exact",
    "ratmath"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/chaos.git"
  },
  "homepage": "https://ratmath.com/chaos/",
  "bugs": {
    "url": "https://github.com/ratmath/chaos/issues"
  },
  "dependencies": {
    "@ratmath/algebraic": "^0.1.0",
    "@ratmath/analytic": "^0.1.0",
    "@ratmath/complex": "^0.3.0"
  },
  "peerDependencies": {
    "@ratmath/core": ">=0.10.0 <0.12.0"
  },
  "devDependencies": {
    "@ratmath/core": "^0.11.0",
    "katex": "0.19.1"
  },
  "types": "index.d.ts",
  "author": "James Taylor",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "vendor/analytic",
    "vendor/algebraic",
    "vendor/complex"
  ]
}
